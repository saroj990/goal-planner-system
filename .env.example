# Copy to .env in each package or at repo root as documented in README (do not commit .env).

# Backend
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goaltracker
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Used in forgot-password reset links (logged in dev when email is not sent)
APP_URL=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:3000/api/v1
